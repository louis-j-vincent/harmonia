# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Top-level symlinks into ~/harmonia — must stay ignored, but ANCHORED (/) so
# they do NOT swallow the harmonia/data/ source package. A bare `data` in
# .git/info/exclude silently untracked harmonia/data/*.py for days (fresh-clone
# ImportError); see known_issues.md "untracked source files" (2026-07-21).
/data
/.venv

# Data — never commit raw audio or large datasets
data/maestro/
data/pop909/
data/lakh/
data/soundfonts/*.sf2
data/cache/
data/tensors/
data/tools/
data/ireal/
data/accomp_db/
*.mid
*.wav
*.mp3
*.flac
*.ogg

# Models — track configs, not weights
checkpoints/
*.pt
*.pth
*.ckpt
*.npy
*.npz

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Tooling
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.DS_Store
.env
*.log

# generated demo audio (reproduce via scripts/make_degraded_example.py)
demo_audio/

# harmonia_server.py runtime state
docs/plots/.yt_video_ids.json
docs/plots/.yt_audio_meta.json
docs/audio/

# large diagnostic HTML (embedded audio) — local viewing only, not committed
docs/plots/grid_ab/

# Brick 0 verification HTMLs (embedded m4a data URIs) — local ear-review only
docs/brick0_review/

# ── chord-training dataset harvest (harmonia/dataset/) ──────────────────────
# Aligner-proposal + drum-track cache (regenerable via harmonia.dataset.harvest):
.dataset_cache/
# Downloaded YouTube audio cache (never committed; rows only REFERENCE audio):
data/dataset_audio/
# Emitted dataset manifests (reference on-disk audio by path+offset; keep out of git):
data/chord_dataset/

# ── Tinder disagreement-triage pages + ledgers (scripts/*_tinder*) ──────────
# Generated HTML embeds base64 audio clips of copyrighted recordings (JAAH,
# brick0) — local ear-review only, regenerable via the build scripts:
docs/research_sessions/*tinder*.html
# Live swipe ledgers (runtime state, mutated per-swipe by tinder_server.py):
docs/research_sessions/*_ledger.json
