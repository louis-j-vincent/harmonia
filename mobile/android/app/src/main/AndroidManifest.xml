<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Flask écoute sur 127.0.0.1 côté device : pas de vrai accès réseau
         nécessaire, mais WebView + Chaquopy s'attendent à la permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="Harmonia"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Harmonia">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sonde P3c (2026-09-23), scaffold de diagnostic seulement (a servi
             à vérifier que Google affiche le vrai formulaire dans une
             WebView, voir le rapport) — pas exportée, pas de chemin de prod
             qui la lance. Voir docs/portage_mobile/p3c_youtube_session.md. -->
        <activity
            android:name=".YouTubeLoginProbeActivity"
            android:exported="false" />

        <!-- Connexion YouTube réelle (P3c) : lancée depuis Python
             (mobile_youtube.open_login_activity(), FLAG_ACTIVITY_NEW_TASK)
             via `POST /api/mobile/youtube_login` -> bouton "Connect YouTube"
             dans prefs.js. Pas exportée au-delà de l'app elle-même. -->
        <activity
            android:name=".YouTubeLoginActivity"
            android:exported="false" />
    </application>
</manifest>
