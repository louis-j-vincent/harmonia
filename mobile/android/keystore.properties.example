# Modèle committable — copie en `keystore.properties` (gitignoré) à côté,
# remplis les 4 valeurs. Voir docs/portage_mobile/p4_apk_release.md pour la
# commande keytool qui génère le keystore, et ~/harmonia/keys/README.txt (sur
# la machine qui l'a généré) pour les mots de passe réels.
storeFile=/Users/CHANGE_ME/harmonia/keys/harmonia-beta.jks
storePassword=CHANGE_ME
keyAlias=harmonia
keyPassword=CHANGE_ME
